Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"LPy2", "[", "y_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rowIndex", ",", "xvals", ",", "lineProfile"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rowIndex", "=", 
       RowBox[{
        RowBox[{"Round", "[", 
         RowBox[{"y", "/", "dy"}], "]"}], "+", "1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"rowIndex", "<", "1"}], "||", 
         RowBox[{"rowIndex", ">", "ny"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"\"\<Error: y = \>\"", "<>", 
          RowBox[{"ToString", "[", "y", "]"}], "<>", 
          "\"\< \[Micro]m is out of range.\>\""}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xvals", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{"dx", "*", 
          RowBox[{"(", 
           RowBox[{"nx", "-", "1"}], ")"}]}], ",", "dx"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lineProfile", "=", 
       RowBox[{"zMatrix", "[", 
        RowBox[{"[", "rowIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"xvals", ",", "lineProfile"}], "}"}], "]"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<x (\[Mu]m)\>\"", ",", "\"\<Current (nA)\>\""}], 
          "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
