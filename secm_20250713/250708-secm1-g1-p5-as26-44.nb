Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "LPy", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"LPyR", "[", "y_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rowIndex", ",", "xvals", ",", "lineProfile"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"rowIndex", "=", 
       RowBox[{
        RowBox[{"Round", "[", 
         RowBox[{"y", "/", "dy"}], "]"}], "+", "1"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"rowIndex", "<", "1"}], "||", 
         RowBox[{"rowIndex", ">", "ny"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"\"\<Error: y = \>\"", "<>", 
          RowBox[{"ToString", "[", "y", "]"}], "<>", 
          "\"\< \[Micro]m is out of range.\>\""}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xvals", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{"dx", "*", 
          RowBox[{"(", 
           RowBox[{"nx", "-", "1"}], ")"}]}], ",", "dx"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lineProfile", "=", 
       RowBox[{"zMatrixR", "[", 
        RowBox[{"[", "rowIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"xvals", ",", "lineProfile"}], "}"}], "]"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<x (\[Mu]m)\>\"", ",", "\"\<Current (nA)\>\""}], 
          "}"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"\"\<Line Profile at y = \>\"", "<>", 
          RowBox[{"ToString", "[", "y", "]"}], "<>", "\"\< \[Mu]m\>\""}]}], 
        ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"PlotStyle", "->", "Thick"}], ",", 
        RowBox[{"LabelStyle", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"FontFamily", "->", "\"\<Arial\>\""}], ",", 
           RowBox[{"FontSize", "->", "14"}]}], "}"}]}], ",", 
        RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.95571875771749*^9, 3.955718765575746*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"31139f52-dd33-4df5-9b5c-721d4d53ec03"],

