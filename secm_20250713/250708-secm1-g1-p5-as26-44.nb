Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"yIndices", "=", 
   RowBox[{
    RowBox[{"Round", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", "Ly", ",", "dy"}], "]"}], "/", "dy"}], "]"}], "+", 
    "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvals", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", 
     RowBox[{"dx", "*", 
      RowBox[{"(", 
       RowBox[{"nx", "-", "1"}], ")"}]}], ",", "dx"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"avgProf", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"{", 
       RowBox[{"xvals", ",", 
        RowBox[{"Mean", "[", 
         RowBox[{"zMat", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "yIndices"}], "]"}], "]"}], "]"}]}], "}"}], 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "zMat", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"avgPplots", "=", "\[IndentingNewLine]", 
  RowBox[{"ListLinePlot", "[", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"avgProf", "[", 
       RowBox[{"[", "i", "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "ndataset"}], "}"}]}], "]"}], ",", 
    RowBox[{"PlotStyle", "->", "Automatic"}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x (\[Mu]m)\>\"", ",", "\"\<Current (nA)\>\""}], "}"}]}], 
    ",", 
    RowBox[{"PlotLabel", "->", "\"\<Avg of line profiles at all y\>\""}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"Placed", "[", 
      RowBox[{
       RowBox[{"LineLegend", "[", "labels", "]"}], ",", "Right"}], "]"}]}], 
    ",", "\[IndentingNewLine]", 
