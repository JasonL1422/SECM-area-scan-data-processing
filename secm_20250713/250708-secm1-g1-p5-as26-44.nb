Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LPyCompare", "[", 
     RowBox[{"z1_", ",", "z2_", ",", "z3_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "rowIndex", ",", "xvals", ",", "curve1", ",", "curve2", ",", 
        "curve3"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rowIndex", "=", 
        RowBox[{
         RowBox[{"Round", "[", 
          RowBox[{"y", "/", "dy"}], "]"}], "+", "1"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"xvals", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{"dx", "*", 
           RowBox[{"(", 
            RowBox[{"nx", "-", "1"}], ")"}]}], ",", "dx"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"curve1", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"xvals", ",", 
           RowBox[{"z1", "[", 
            RowBox[{"[", "rowIndex", "]"}], "]"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"curve2", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"xvals", ",", 
           RowBox[{"z2", "[", 
            RowBox[{"[", "rowIndex", "]"}], "]"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"curve3", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"xvals", ",", 
           RowBox[{"z3", "[", 
            RowBox[{"[", "rowIndex", "]"}], "]"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"curve1", ",", "curve2", ",", "curve3"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", "Blue", ",", "Green"}], "}"}]}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x (\[Mu]m)\>\"", ",", "\"\<Current (nA)\>\""}], 
           "}"}]}], ",", 
         RowBox[{"PlotLabel", "->", 
          RowBox[{"\"\<Line Profile at y = \>\"", "<>", 
           RowBox[{"ToString", "[", "y", "]"}], "<>", "\"\< \[Mu]m\>\""}]}], 
         ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"LineLegend", "[", 
             RowBox[{"{", 
              RowBox[{
              "\"\<Data 1\>\"", ",", "\"\<Data 2\>\"", ",", "\"\<Data3\>\""}],
               "}"}], "]"}], ",", "Right"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"LabelStyle", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"FontFamily", "->", "\"\<Arial\>\""}], ",", 
            RowBox[{"FontSize", "->", "14"}]}], "}"}]}], ",", 
         RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"LPyCompare", "[", 
  RowBox[{
   RowBox[{"zMat", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", 
