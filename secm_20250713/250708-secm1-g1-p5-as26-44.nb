          RowBox[{"(", 
           RowBox[{"nx", "-", "1"}], ")"}]}], ",", "dx"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"lineProfile", "=", 
       RowBox[{"zMatrixR", "[", 
        RowBox[{"[", "rowIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
