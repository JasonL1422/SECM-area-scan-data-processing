Cell[BoxData["\"\<ClearAll[getZ];\[IndentingNewLine]getZ[x_,y_]:=Module[{xi,\
yi},\[IndentingNewLine]xi=Round[x/dx]+1;\[IndentingNewLine]yi=Round[y/dy]+1;\
\[IndentingNewLine]];\>"], "Input",
 CellChangeTimes->{{3.95571597661829*^9, 3.9557160216629553`*^9}, {
  3.961072266804912*^9, 3.96107227549197*^9}, {3.961072359975107*^9, 
  3.961072392818877*^9}},
 EmphasizeSyntaxErrors->
  True,ExpressionUUID->"822c74da-676c-45e8-bb84-2861862c254a"],

Cell[BoxData["\"\<ClearAll[setZ];\[IndentingNewLine]setZ[x_,y_,newVal_]:=\
Module[{xi,yi},\[IndentingNewLine]xi=Round[x/dx]+1;\[IndentingNewLine]yi=\
Round[y/dy]+1;\[IndentingNewLine]];\>"], "Input",
 CellChangeTimes->{{3.95571598062853*^9, 3.955715980642229*^9}, {
   3.955716036367073*^9, 3.9557160463404503`*^9}, 3.9610722811519136`*^9, {
   3.96107237668454*^9, 
   3.9610723937908907`*^9}},ExpressionUUID->"d20d4dd4-9191-4e2c-8d18-\
cb92968abde2"],

Cell[BoxData["\"\<ClearAll[SmoothZSpike];\[IndentingNewLine]SmoothZSpike[\
xStart_,xEnd_,y_,noiseAmp_:0.05]:=Module[{xiStart,xiEnd,yi,z1,z2,n,xs,linFit,\
noise,newVals},(*Index conversion*)xiStart=Round[xStart/dx]+1;\
\[IndentingNewLine]xiEnd=Round[xEnd/dx]+1;\[IndentingNewLine]yi=Round[y/dy]+1;\
\[IndentingNewLine](*Length and original \
endpoints*)\[IndentingNewLine]n=xiEnd-xiStart+1;\[IndentingNewLine]z1=zMatrix[\
[yi,xiStart]];\[IndentingNewLine]z2=zMatrix[[yi,xiEnd]];\[IndentingNewLine](*\
X-index vector*)\[IndentingNewLine]xs=Range[0,n-1];\[IndentingNewLine](*\
Linear interpolation+small \
noise*)\[IndentingNewLine]linFit=z1+(z2-z1)*(xs/(n-1));\[IndentingNewLine]\
noise=RandomReal[{-noiseAmp,noiseAmp},n];\[IndentingNewLine]newVals=linFit+\
noise;\[IndentingNewLine](*Apply \
correction*)\[IndentingNewLine]Do[zMatrix[[yi,xiStart+i-1]]=newVals[[i]],{i,1,\
n}];\[IndentingNewLine](*Return updated profile for review*)\
\[IndentingNewLine]newVals];\>"], "Input",
 CellChangeTimes->{{3.95571638636368*^9, 3.955716405549547*^9}, {
   3.955716512671636*^9, 3.955716573181711*^9}, 3.961072284706142*^9, {
   3.96107238035524*^9, 3.961072395380889*^9}},
 EmphasizeSyntaxErrors->
  True,ExpressionUUID->"0a2e6ce9-f9e9-4ae0-9dc0-01d0242818c3"]
}, Closed]],

