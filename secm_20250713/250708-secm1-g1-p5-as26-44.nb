Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"normalize", "[", "data_", "]"}], ":=", 
    RowBox[{"Transpose", "@", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
       RowBox[{"Rescale", "[", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"normalize2", "[", "data_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xvals", ",", "yvals", ",", "maxval"}], "}"}], ",", 
      RowBox[{
       RowBox[{"xvals", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yvals", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxval", "=", 
        RowBox[{"Max", "[", "yvals", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{"xvals", ",", 
          RowBox[{"yvals", "/", "maxval"}]}], "}"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"normalize3", "[", "data_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xvals", ",", "yvals", ",", "meanval"}], "}"}], ",", 
      RowBox[{
       RowBox[{"xvals", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yvals", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanval", "=", 
        RowBox[{"Mean", "[", "yvals", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{"xvals", ",", 
          RowBox[{"yvals", "/", "meanval"}]}], "}"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"normalize4", "[", "data_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xvals", ",", "yvals", ",", "refIndex", ",", "refVal"}], "}"}],
       ",", 
      RowBox[{
       RowBox[{"xvals", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yvals", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"refIndex", "=", 
        RowBox[{"First", "@", 
         RowBox[{"FirstPosition", "[", 
          RowBox[{"xvals", ",", 
           RowBox[{"x_", "/;", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"x", "-", "600"}], "]"}], "<", 
             RowBox[{"10", "^", 
              RowBox[{"-", "3"}]}]}]}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"refVal", "=", 
        RowBox[{"yvals", "[", 
         RowBox[{"[", "refIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{"xvals", ",", 
          RowBox[{"yvals", "/", "refVal"}]}], "}"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"normalize5", "[", "data_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"xvals", ",", "yvals", ",", "sel", ",", "meanval"}], "}"}], 
      ",", 
      RowBox[{
       RowBox[{"xvals", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yvals", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"sel", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Transpose", "@", 
           RowBox[{"{", 
            RowBox[{"xvals", ",", "yvals"}], "}"}]}], ",", 
          RowBox[{
           RowBox[{"400", "<=", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<=", "800"}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"meanval", "=", 
        RowBox[{"Mean", "[", 
         RowBox[{"sel", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{"xvals", ",", 
          RowBox[{"yvals", "/", "meanval"}]}], "}"}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nnA", "=", 
   RowBox[{"normalize", "/@", "avgProf"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nnB", "=", 
