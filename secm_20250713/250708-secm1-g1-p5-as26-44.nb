Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapA2", "[", 
   RowBox[{"temp_", ",", "cont_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "rr", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rr", "=", 
      RowBox[{"Round", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{"i", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Min", "[", "temp", "]"}], ",", 
            RowBox[{"Max", "[", "temp", "]"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Max", "[", "temp", "]"}], "-", 
               RowBox[{"Min", "[", "temp", "]"}]}], ")"}], "/", "cont"}]}], 
           "}"}]}], "]"}], ",", "0.01"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"ListContourPlot", "[", 
      RowBox[{"temp", ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"FontFamily", "->", "\"\<Arial\>\""}], ",", 
          RowBox[{"FontSize", "->", "16"}], ",", "Black"}], "}"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
       RowBox[{"FrameTicks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"tickY", ",", "None"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"tickX", ",", "None"}], "}"}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"AspectRatio", "->", 
        RowBox[{
         RowBox[{"Ly", "/", "Lx"}], "*", "asratio"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"GridLines", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "Lx", ",", "100"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", "Ly", ",", "10"}], "]"}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"ny", "-", "1"}], ")"}], "/", "Ly"}]}]}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Method", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<GridLinesInFront\>\"", "->", "True"}], "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"ColorFunction", "->", "\"\<Rainbow\>\""}], ",", 
       RowBox[{"Contours", "->", "rr"}], ",", 
       RowBox[{"ContourStyle", "->", "None"}], ",", "\[IndentingNewLine]", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"BarLegend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Min", "[", "rr", "]"}], ",", 
                RowBox[{"Max", "[", "rr", "]"}]}], "}"}]}], "}"}], ",", 
            RowBox[{"LegendMarkerSize", "->", "Medium"}], ",", 
            RowBox[{"LegendLabel", "->", "\"\<Intensity\>\""}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"After", ",", "Top"}], "}"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotLabel", "->", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
          "Lx", ",", "\"\<\[Mu]m\>\"", ",", "\"\< (\>\"", ",", "dx", ",", 
           "\"\<\[Mu]m\>\"", ",", "\"\<) x \>\"", ",", "Ly", ",", 
           "\"\<\[Mu]m\>\"", ",", "\"\< (\>\"", ",", "dy", ",", 
           "\"\<\[Mu]m\>\"", ",", "\"\<)\>\""}], "}"}], "]"}]}]}], "]"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"mapA2", "[", 
  RowBox[{
   RowBox[{"zMat", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", "20"}], "]"}]}], "Input",
