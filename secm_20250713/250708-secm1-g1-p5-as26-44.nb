Cell[BoxData[{
 RowBox[{
  RowBox[{"avgProfile2", "=", 
   RowBox[{"Mean", "[", 
    RowBox[{"zMatrixR", "[", 
     RowBox[{"[", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3", ",", "4"}], "}"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xvals", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", 
     RowBox[{"dx", "*", 
      RowBox[{"(", 
       RowBox[{"nx", "-", "1"}], ")"}]}], ",", "dx"}], "]"}]}], ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"xvals", ",", "avgProfile2"}], "}"}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x (\[Mu]m)\>\"", ",", "\"\<Averaged Current (nA)\>\""}], 
     "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "->", "\"\<Averaged Profile at y = 0, 10, 20 \[Mu]m\>\""}], 
   ",", 
   RowBox[{"PlotStyle", "->", "Thick"}], ",", 
   RowBox[{"LabelStyle", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"FontFamily", "->", "\"\<Arial\>\""}], ",", 
      RowBox[{"FontSize", "->", "14"}]}], "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], "Input",
